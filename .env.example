# Firebase Project Configuration
FIREBASE_PROJECT_ID="your-project-id"

# Firebase Admin SDK (Server-side)
# Generate at: https://console.firebase.google.com/project/_/settings/serviceaccounts/adminsdk
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Client SDK (Public - Safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123..."

# Paystack Configuration (Optional - for payment processing)
# Get from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_..."

# Firebase Cloud Messaging (Push Notifications)
# Generate at: Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key-from-firebase-console"

# Application URL (Required for Paystack redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env to git (it's in .gitignore)
# 4. For production, set these in your Vercel dashboard

# Firebase Cloud Messaging (Push Notifications)
NEXT_PUBLIC_FIREBASE_VAPID_KEY="your-vapid-key-from-firebase-console"
